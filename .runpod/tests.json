{
  "tests": [
    {
      "name": "ocr_text_recognition",
      "input": {
        "model": "zai-org/GLM-OCR",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://huggingface.co/zai-org/GLM-OCR/resolve/main/assets/demo.png"
                }
              },
              {
                "type": "text",
                "text": "Text Recognition:"
              }
            ]
          }
        ],
        "max_tokens": 2048,
        "temperature": 0.0
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "allowedCudaVersions": [
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ]
  }
}
